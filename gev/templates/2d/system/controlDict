FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         3000;
deltaT          1;
writeControl    timeStep;
writeInterval   50;
purgeWrite      0;
writeFormat     ascii;
writePrecision  12;     // mesh points: 6 digits are only 10 um at x ~ 1 m, as thin as the first wall layer
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    #include "forceCoeffs"      // written by gev.case2d (lRef/Aref from the body)
    #include "solverInfo"

    yPlus
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }

    wallShearStress     // separation detection (separation.py)
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }
}

