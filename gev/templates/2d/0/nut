FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

#include "initialConditions"

internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"


    inlet
    {
        type            calculated;
        value           uniform 0;
    }

    outlet
    {
        type            zeroGradient;
    }
    
    
    
    top
    {
		type			zeroGradient;
	}

    ground
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    "body_.*"
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
}


