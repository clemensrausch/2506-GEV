FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "initialConditions"

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $pressure;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            fixedValue;
        value           $internalField;
    }

    
	
	top
	{
		type			zeroGradient;
	}
    
    ground
    {
        type            fixedFluxPressure;
        value			uniform 0;
    }

    "body_.*"
    {
        type            fixedFluxPressure;
        value			uniform 0;
    }
        
}


