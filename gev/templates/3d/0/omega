FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "initialConditions"

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform $turbulentOmega;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }

    "(top|side)"
    {
        type            slip;
    }

    // y+ ~ 1 on some parts, wall functions on others: smooth viscous/log blending (default is a hard switch)
    ground
    {
        type            omegaWallFunction;
        blending        binomial;
        n               2;
        value           $internalField;
    }

    car             // patch group of all car parts
    {
        type            omegaWallFunction;
        blending        binomial;
        n               2;
        value           $internalField;
    }
}

