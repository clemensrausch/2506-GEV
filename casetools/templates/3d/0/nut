FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            calculated;
        value           uniform 0;
    }

    outlet
    {
        type            calculated;
        value           uniform 0;
    }

    "(top|side)"
    {
        type            slip;
    }

    // Spalding's law covers the viscous sublayer and the log layer: valid for y+ ~ 1 and for y+ 30-300
    ground
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }

    car             // patch group of all car parts
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
}

