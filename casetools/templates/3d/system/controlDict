FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         3000;           // set by casetools.run3d

deltaT          1;

writeControl    timeStep;

writeInterval   500;

purgeWrite      1;              // keep only the latest fields (3D cases are large)

writeFormat     binary;

writePrecision  10;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    #include "forces"           // written by casetools.mesh3d: per part and total, reference values from the profile
    #include "solverInfo"

    yPlus
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }

    wallShearStress     // separation detection
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        patches         (car);
        writeControl    writeTime;
    }
}

